{
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.renderWhitespace": "none"
  },
  "markdown.preview.breaks": false,
  "markdown.extension.toc.levels": "2..3",
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": false
  },
  "files.exclude": {
    "site/": true,
    ".venv/": true,
    "source/": true
  }
}
